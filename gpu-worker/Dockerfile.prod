# Production image — base layer(CUDA+SAM3+모델) 위에 handler/engine/presets 코드 교체
# ⚠️ :latest는 base layer 전용. 직접 실행하면 구 handler가 동작하므로 사용 금지.
FROM jonghwan0309/sam3-worker:latest

WORKDIR /app

# Gemini API 의존성 추가
RUN pip install --no-cache-dir google-genai>=1.0.0

# 현재 코드로 handler + engine + presets 교체
COPY handler.py /app/handler.py
COPY engine/ /app/engine/
COPY presets/ /app/presets/

CMD ["python3", "-u", "handler.py"]
