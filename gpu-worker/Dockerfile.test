# Lightweight test image — no CUDA, no SAM3
# Tests the full pipeline: R2 download → dummy process → R2 upload → callback
FROM python:3.12-slim

WORKDIR /app

# Install dependencies (no torch/sam3)
RUN pip install --no-cache-dir \
    runpod>=1.7.0 \
    httpx>=0.28.0 \
    Pillow>=11.0.0 \
    boto3>=1.35.0

# Copy application code
COPY engine/r2_io.py engine/r2_io.py
COPY engine/callback.py engine/callback.py
COPY engine/__init__.py engine/__init__.py
COPY handler_test.py handler.py

# Runpod serverless handler
CMD ["python", "-u", "handler.py"]
